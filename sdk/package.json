{
  "name": "@louisinger/future-sdk",
  "version": "0.1.0",
  "description": "Client for Arkade futures: a BTC/USD market of Arkade Script contracts with no backend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisinger/future.git",
    "directory": "sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifacts/*": "./contracts/artifacts/*",
    "./templates/*": "./contracts/executor-templates/*"
  },
  "files": [
    "dist",
    "contracts/artifacts",
    "contracts/executor-templates"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "pretest": "pnpm -C ../oracle build",
    "pretest:e2e": "pnpm -C ../oracle build",
    "pretypecheck": "pnpm -C ../oracle build",
    "prebuild": "pnpm -C ../oracle build"
  },
  "dependencies": {
    "@louisinger/dia-oracle": "workspace:*",
    "@arkade-os/sdk": "0.5.13",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
