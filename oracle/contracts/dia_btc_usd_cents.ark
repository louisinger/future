pragma arkade ^0.1.0;

struct PriceQuote {
  int price;
  int time;
}

// Reusable DIA BTC/USD (in USD cents) verifier and quote reader.
// verifyPrice checks DIA's EIP-712 OracleUpdate (Lasernet chain 1050, BTC/USD)
// and rounds the 18-decimal price to USD cents. Callers add their own time rule.
// readPrice lets consumers read the verified quote from packet 34 on input 1.
library DiaBtcUsdCents {
  const int PACKET = 34;
  const int SCALE = 10000000000000000;
  const int HALF = 5000000000000000;
  const int PRICE_MAX = 1000000000;
  const bytes32 DOMAIN = 0xf57d55f057fd4aba6b1a7f8bccb6a3e826cf71fd34971f22a39d7ffd6e620fb3;
  const bytes32 TYPEHASH = 0x24e574fa7512cc24e9109b981256e33759d91bc2ee9b74a2bf633e013c0620b5;
  const bytes32 INTENT_TYPE = 0xef9b6324ed493183babb66ed98fcf36e9bcb0243ae4c5a29fcd99184b08f1899;
  const bytes32 VERSION = 0xe6bbd6277e1bf288eed5e8d1780f9a50b239e86b153736bceebccf4ea79d90b3;
  const bytes32 SYMBOL = 0xee62665949c883f9e0f6f002eac32e00bd59dfe6c34e92a91c37d6a8322d6489;
  const bytes32 SOURCE = 0xf5a695b63ab16fd8278cb1cf7d29f274a9574b64e0b894750e08c990fc8891bc;

  function word(int n) bytes {
    return reverseBytes(int2bytes(n, 32));
  }

  function verifyPrice(
    bytes oraclePk,
    int rawPrice,
    int time,
    int nonce,
    int intentExpiry,
    signature sig
  ) int {
    int cents = rawPrice / SCALE;
    if (rawPrice % SCALE >= HALF) {
      cents = cents + 1;
    }
    require(cents > 0 && cents <= PRICE_MAX, "price bounds");

    bytes body = TYPEHASH + INTENT_TYPE + VERSION
      + word(1050) + word(nonce) + word(intentExpiry)
      + SYMBOL + word(rawPrice) + word(time) + SOURCE;
    bytes32 message = bytes32(digest(0x1901 + DOMAIN + bytes32(digest(body, 4)), 4));
    require(checkSigFromStack(sig, oraclePk, message), "bad oracle sig");
    return cents;
  }

  function readPrice(AssetId oracleId) PriceQuote {
    require(tx.numInputs >= 2, "oracle");
    require(tx.inputs[1].assets.lookup(oracleId) == 1, "oracle");
    bytes quote = tx.packet(PACKET);
    require(size(quote) == 17, "quote size");
    require(substr(quote, 0, 1) == 0x01, "quote version");
    int price = bytes2int(substr(quote, 1, 8));
    int time = bytes2int(substr(quote, 9, 8));
    require(price > 0 && price <= PRICE_MAX, "price bounds");
    require(time > 0, "time");
    return PriceQuote { price: price, time: time };
  }
}
